<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta
name="viewport"
content="width=device-width,initial-scale=1.0"
>

<title>Logical World Chat</title>

<style>

*{
box-sizing:border-box;
margin:0;
padding:0;
}

body{
font-family:Arial,sans-serif;
background:#f4f4f4;
color:#222;
font-size:16px;
}

.header{
background:#0a4ea3;
color:white;
padding:12px 10px;
text-align:center;
}

.header h1{
font-size:21px;
margin-bottom:8px;
}

.back{
display:block;
color:white;
text-decoration:none;
font-size:14px;
margin-bottom:5px;
}

.container{
width:100%;
max-width:450px;
margin:0 auto;
padding:10px;
}

.box{
background:white;
border:1px solid #ddd;
border-radius:6px;
padding:12px;
margin-bottom:10px;
}

.title{
font-weight:bold;
font-size:17px;
margin-bottom:8px;
}

input{
width:100%;
padding:11px;
border:1px solid #bbb;
border-radius:5px;
font-size:16px;
}

button{
width:100%;
padding:12px;
margin-top:8px;
border:0;
border-radius:5px;
background:#0a4ea3;
color:white;
font-size:16px;
font-weight:bold;
}

button:disabled{
opacity:.6;
}

.message-list{
background:white;
border:1px solid #ddd;
border-radius:6px;
min-height:180px;
max-height:420px;
overflow-y:auto;
padding:10px;
}

.message{
margin-bottom:10px;
padding:9px;
border-radius:6px;
max-width:90%;
line-height:1.4;
}

.sent{
background:#dbeafe;
margin-left:auto;
}

.received{
background:#eeeeee;
margin-right:auto;
}

.sender{
font-size:12px;
font-weight:bold;
color:#555;
margin-bottom:3px;
}

.time{
font-size:11px;
color:#777;
margin-top:4px;
}

.empty{
text-align:center;
color:#777;
padding:30px 10px;
}

.status{
font-size:13px;
color:#666;
margin-top:6px;
}

.error{
display:none;
background:#f8d7da;
color:#842029;
padding:10px;
border-radius:5px;
margin-bottom:10px;
line-height:1.4;
}

.success{
display:none;
background:#d1e7dd;
color:#0f5132;
padding:10px;
border-radius:5px;
margin-bottom:10px;
line-height:1.4;
}

.small-link{
display:block;
text-align:center;
margin-top:10px;
color:#0a4ea3;
text-decoration:none;
font-weight:bold;
}

</style>

</head>


<body>


<div class="header">

<a
class="back"
href="mobile.html"
>
← Back to Logical World
</a>

<h1>💬 Logical World Chat</h1>

</div>


<div class="container">


<div
class="error"
id="errorBox"
>
</div>


<div
class="success"
id="successBox"
>
</div>


<div
class="box"
id="searchBox"
>

<div class="title">
Find User
</div>

<input
type="text"
id="searchInput"
placeholder="Enter phone number"
autocomplete="off"
>

<button
id="findUserBtn"
>
Find User
</button>

<div
class="status"
id="searchStatus"
>
Search for a Logical World user by phone number.
</div>

</div>


<div
class="box"
id="conversationBox"
style="display:none;"
>

<div class="title">
Chatting with
</div>

<div
id="chatUserName"
>
User
</div>

<div
class="status"
id="chatUserPhone"
>
</div>

</div>


<div
class="message-list"
id="messageList"
>

<div class="empty">
Find a user above to start chatting.
</div>

</div>


<div
class="box"
id="sendBox"
style="display:none;"
>

<input
type="text"
id="messageInput"
placeholder="Type your message"
autocomplete="off"
>

<button
id="sendBtn"
>
Send Message
</button>

</div>


<a
class="small-link"
href="mobile.html"
>
Main Menu
</a>


</div>


<script type="module">


/* =====================================================
   FIREBASE
===================================================== */

import {
auth,
db
}
from "./firebase.js";


import {
onAuthStateChanged
}
from
"https://www.gstatic.com/firebasejs/12.2.1/firebase-auth.js";


import {
collection,
query,
where,
getDocs,
addDoc,
serverTimestamp,
onSnapshot
}
from
"https://www.gstatic.com/firebasejs/12.2.1/firebase-firestore.js";


/* =====================================================
   ELEMENTS
===================================================== */

const searchInput =
document.getElementById(
"searchInput"
);

const findUserBtn =
document.getElementById(
"findUserBtn"
);

const searchStatus =
document.getElementById(
"searchStatus"
);

const conversationBox =
document.getElementById(
"conversationBox"
);

const chatUserName =
document.getElementById(
"chatUserName"
);

const chatUserPhone =
document.getElementById(
"chatUserPhone"
);

const messageList =
document.getElementById(
"messageList"
);

const sendBox =
document.getElementById(
"sendBox"
);

const messageInput =
document.getElementById(
"messageInput"
);

const sendBtn =
document.getElementById(
"sendBtn"
);

const errorBox =
document.getElementById(
"errorBox"
);

const successBox =
document.getElementById(
"successBox"
);


/* =====================================================
   VARIABLES
===================================================== */

let currentUser =
null;

let selectedUser =
null;

let conversationId =
null;

let unsubscribeMessages =
null;


/* =====================================================
   MESSAGE HELPERS
===================================================== */

function showError(
text
){

errorBox.textContent =
text;

errorBox.style.display =
"block";

successBox.style.display =
"none";

}


function showSuccess(
text
){

successBox.textContent =
text;

successBox.style.display =
"block";

errorBox.style.display =
"none";


setTimeout(
()=>{

successBox.style.display =
"none";

},
3000
);

}


/* =====================================================
   NORMALIZE PHONE
===================================================== */

function normalizePhone(
phone
){

phone =
String(phone || "")
.trim()
.replace(/\s+/g,"");


if(
phone.startsWith("0")
){

return "+234" +
phone.substring(1);

}


if(
phone.startsWith("234")
){

return "+" +
phone;

}


return phone;

}


/* =====================================================
   CREATE CONVERSATION ID
===================================================== */

function makeConversationId(
uid1,
uid2
){

return [
uid1,
uid2
]
.sort()
.join("_");

}


/* =====================================================
   AUTH
===================================================== */

onAuthStateChanged(
auth,
(user)=>{


if(!user){

location.href =
"mobile-register.html";

return;

}


currentUser =
user;

});


/* =====================================================
   FIND USER
===================================================== */

findUserBtn.addEventListener(
"click",
async()=>{


if(!currentUser){

showError(
"Your account is still loading. Please wait."
);

return;

}


const enteredPhone =
normalizePhone(
searchInput.value
);


if(
enteredPhone === ""
){

showError(
"Enter the user's phone number."
);

return;

}


if(
normalizePhone(
currentUser.phoneNumber
) === enteredPhone
){

showError(
"You cannot start a chat with yourself."
);

return;

}


try{


findUserBtn.disabled =
true;

findUserBtn.textContent =
"Searching...";

searchStatus.textContent =
"Searching...";


/* =================================================
   FIND USER BY PHONE NUMBER
================================================= */

const usersRef =
collection(
db,
"users"
);


const userQuery =
query(

usersRef,

where(
"phoneNumber",
"==",
enteredPhone
)

);


const snapshot =
await getDocs(
userQuery
);


if(
snapshot.empty
){

searchStatus.textContent =
"";

showError(
"No Logical World user was found with that phone number."
);

return;

}


let foundUser =
null;


snapshot.forEach(
(docSnap)=>{

foundUser = {
id:
docSnap.id,

...docSnap.data()

};

});


if(!foundUser){

showError(
"User could not be loaded."
);

return;

}


selectedUser =
foundUser;


conversationId =
makeConversationId(
currentUser.uid,
selectedUser.uid
);


/* =================================================
   SHOW CHAT
================================================= */

chatUserName.textContent =

selectedUser.name ||

selectedUser.displayName ||

"Logical World User";


chatUserPhone.textContent =

selectedUser.phoneNumber ||

enteredPhone;


conversationBox.style.display =
"block";

sendBox.style.display =
"block";


searchStatus.textContent =
"User found.";


errorBox.style.display =
"none";


/* =================================================
   START REAL-TIME MESSAGE LIST
================================================= */

startMessagesListener();


}catch(error){

console.error(
"Find user error:",
error
);


showError(
"Could not search for the user: " +
error.message
);


}finally{

findUserBtn.disabled =
false;

findUserBtn.textContent =
"Find User";

}

});


/* =====================================================
   LISTEN FOR MESSAGES
===================================================== */

function startMessagesListener(){

if(
unsubscribeMessages
){

unsubscribeMessages();

}


messageList.innerHTML =

'<div class="empty">Loading messages...</div>';


const messagesRef =
collection(
db,
"messages"
);


const messageQuery =
query(

messagesRef,

where(
"conversationId",
"==",
conversationId
)

);


unsubscribeMessages =

onSnapshot(

messageQuery,

(snapshot)=>{


const messages =
[];


snapshot.forEach(
(docSnap)=>{

messages.push({

id:
docSnap.id,

...docSnap.data()

});

});


/*
   Sort in the browser.

   This avoids requiring a Firestore
   composite index for this first version.
*/

messages.sort(
(a,b)=>{

const timeA =
a.createdAt &&
a.createdAt.toMillis
?
a.createdAt.toMillis()
:
0;

const timeB =
b.createdAt &&
b.createdAt.toMillis
?
b.createdAt.toMillis()
:
0;

return timeA - timeB;

});


displayMessages(
messages
);

},

(error)=>{

console.error(
"Message listener error:",
error
);

showError(
"Could not load messages: " +
error.message
);

}

);

}


/* =====================================================
   DISPLAY MESSAGES
===================================================== */

function displayMessages(
messages
){


if(
messages.length === 0
){

messageList.innerHTML =

'<div class="empty">' +
'No messages yet.<br>' +
'Send the first message.' +
'</div>';

return;

}


messageList.innerHTML =
"";


messages.forEach(
(message)=>{


const wrapper =
document.createElement(
"div"
);


wrapper.className =
"message";


if(
message.senderId ===
currentUser.uid
){

wrapper.classList.add(
"sent"
);

}else{

wrapper.classList.add(
"received"
);

}


const sender =
document.createElement(
"div"
);

sender.className =
"sender";


sender.textContent =

message.senderId ===
currentUser.uid

?
"You"

:
(
selectedUser.name ||
selectedUser.displayName ||
"User"
);


const text =
document.createElement(
"div"
);


text.textContent =
message.text ||
"";


const time =
document.createElement(
"div"
);

time.className =
"time";


if(
message.createdAt &&
message.createdAt.toDate
){

time.textContent =

message.createdAt
.toDate()
.toLocaleString(
"en-NG"
);

}


wrapper.appendChild(
sender
);

wrapper.appendChild(
text
);

wrapper.appendChild(
time
);


messageList.appendChild(
wrapper
);

});


messageList.scrollTop =
messageList.scrollHeight;

}


/* =====================================================
   SEND MESSAGE
===================================================== */

sendBtn.addEventListener(
"click",
sendMessage
);


messageInput.addEventListener(
"keydown",
(event)=>{

if(
event.key ===
"Enter"
){

event.preventDefault();

sendMessage();

}

});


async function sendMessage(){

if(
!currentUser ||
!selectedUser ||
!conversationId
){

showError(
"Please find a user before sending a message."
);

return;

}


const text =
messageInput.value.trim();


if(
text === ""
){

return;

}


try{


sendBtn.disabled =
true;

sendBtn.textContent =
"Sending...";


const messagesRef =
collection(
db,
"messages"
);


/* =================================================
   SEND THE ACTUAL MESSAGE
================================================= */

await addDoc(

messagesRef,

{

conversationId:
conversationId,

senderId:
currentUser.uid,

senderName:

currentUser.displayName ||
currentUser.email ||
"User",

receiverId:
selectedUser.uid,

receiverName:

selectedUser.name ||
selectedUser.displayName ||
"User",

text:
text,

read:
false,

createdAt:
serverTimestamp()

}

);


/* =================================================
   CREATE NOTIFICATION FOR RECIPIENT
================================================= */

try{

const notificationsRef =
collection(
db,
"notifications"
);


await addDoc(

notificationsRef,

{

receiverId:
selectedUser.uid,

senderId:
currentUser.uid,

title:
"New message",

text:
(
currentUser.displayName ||
currentUser.email ||
"User"
) +
": " +
text,

read:
false,

type:
"message",

conversationId:
conversationId,

createdAt:
serverTimestamp()

}

);


}catch(notificationError){

/*
   If notification creation fails,
   the message has already been sent.

   We do NOT show a message-send error
   because the actual chat message succeeded.
*/

console.error(
"Notification creation error:",
notificationError
);

}


messageInput.value =
"";


showSuccess(
"Message sent."
);


}catch(error){

console.error(
"Send message error:",
error
);


showError(
"Message could not be sent: " +
error.message
);


}finally{

sendBtn.disabled =
false;

sendBtn.textContent =
"Send Message";

}

}


</script>


</body>

</html>
